# Data source: "api" uses the REST backend, anything else falls back to the mock provider
NEXT_PUBLIC_DATA_SOURCE=

# ── Hashnode headless CMS (Solution Articles) ────────────────────────────────
# Your publication host, e.g. myorg.hashnode.dev or a custom domain like blog.myorg.com
# (no protocol, host only). Leave empty to hide the Solution Articles section.
HASHNODE_PUBLICATION_HOST=

# Optional: personal access token from https://hashnode.com/settings/developer
# Needed only for private publications / higher rate limits. Server-side only.
HASHNODE_ACCESS_TOKEN=